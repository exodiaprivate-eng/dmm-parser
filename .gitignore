*.paz

# Output files
out/

# Tools / game files (top-level only — Phase T mod-author CLIs live at
# python/dmm_parser/tools/ and SHOULD be tracked)
# NB: exclude the CONTENTS, not the directory -- git cannot re-include a file
# whose parent DIRECTORY is excluded, so `/tools/` + `!/tools/patchday/` silently
# does nothing.
/tools/*
# ...EXCEPT the patch-day toolkit, which must survive a reclone: it IS the
# process for responding to a game update. Game files, hash baselines and
# scratch dumps under /tools/ stay ignored.
!/tools/patchday/
/tools/patchday/*
!/tools/patchday/*.py
!/tools/patchday/README.md
node_modules/
package.json
package-lock.json

# Claude Code local settings
.claude/
.mcp.json

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
fixtures_1_06/

# Debug symbols — never track (regenerated every build, 3MB churn)
*.pdb
